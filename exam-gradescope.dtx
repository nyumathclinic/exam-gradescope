%\changes{v0.1}{2026/10/30}{First version}
%
% \begin{abstract}
%   The \textsf{exam-gradescope} package records the questions of a document
%   made with the \textsf{exam} class while it is typeset with \LuaLaTeX, and
%   writes the files that Gradescope (\url{https://www.gradescope.com}) needs
%   to grade it: an outline of where each question is on the page, a rubric
%   for each question, an answer key for a bubble sheet, and a manifest of the
%   questions for item analysis.
% \end{abstract}
%
% \tableofcontents
%
% \section{Introduction}
%
% Grading a paper exam on Gradescope starts with an \emph{outline}: a box,
% drawn by hand on the blank exam, around each question and around the
% student's name and ID. Each question then needs a \emph{rubric}. For a
% multiple-choice question that means copying the right answer, which differs
% from version to version, into the rubric by hand. Questions answered on a
% bubble sheet need an answer key instead.
%
% Everything this takes is already in the \LaTeX{} source: where each question
% falls on the page, how many points it is worth, which choice is correct.
% This package writes it down while the document is typeset:
%
% \begin{description}
%   \item[\meta{jobname}.outline.json] the question regions and the name and
%     ID regions, as percentages of the page;
%   \item[\meta{jobname}.rubric.json] a rubric for every question: made from
%     the correct choices for multiple-choice and check-all-that-apply
%     questions, and written in the source (see section~\ref{sec:rubrics}) for
%     free-response ones;
%   \item[\meta{jobname}.key.csv] the answer key of the questions answered on
%     a bubble sheet;
%   \item[\meta{jobname}.json] a manifest of all the questions: number, a
%     name that is the same on every version, points, type and answer.
% \end{description}
% All of them are made from the same run as the PDF. In particular the answer
% key and rubrics come from the blank exam, after any shuffling of choices,
% not from a separate solutions run.
%
% Gradescope has no public interface for uploading outlines and rubrics. The
% command \texttt{edubag gradescope client setup-exam} of the Python package
% \textsf{edubag} (\url{https://github.com/nyumathclinic/python-edubag}) reads
% these files and sets up a multi-version exam on Gradescope; the
% \texttt{gradescope-tampermonkey} rubric importer
% (\url{https://github.com/nyumathclinic/gradescope-tampermonkey}) reads the
% rubric files in a browser.
%
% \section{Requirements}
%
% \begin{itemize}
%   \item \LuaLaTeX{} (the package records positions with Lua at shipout);
%   \item the \textsf{exam} class, or a class built on it;
%   \item a \LaTeX{} kernel from 2023 or later.
% \end{itemize}
% The package works with \textsf{exam-randomizechoices}, loaded before or after
% it.
%
% \section{Usage}
%
% Load the package after the \textsf{exam} class:
% \begin{verbatim}
% \documentclass{exam}
% \usepackage{exam-gradescope}
% \end{verbatim}
% Nothing else is needed for multiple-choice questions and for the outline of
% the questions. The files are written at the end of the run, next to the PDF.
%
% \subsection{Where questions go}
%
% Each question is \emph{multiple choice} if it has a \env{choices} or
% \env{oneparchoices} environment with a |\CorrectChoice|,
% \emph{check all that apply} if it has a \env{checkboxes} or
% \env{oneparcheckboxes} environment, and \emph{free response} otherwise.
%
% Free-response questions are graded on Gradescope. Multiple-choice and
% check-all-that-apply questions go where the option \option{mc} says:
% \begin{description}
%   \item[\texttt{mc=gradescope}] (the default) they are graded on Gradescope
%     like the others, with rubrics made from their correct choices;
%   \item[\texttt{mc=bubble}] they are answered on a bubble sheet: they go in
%     the answer key, and are left out of the outline and rubrics.
% \end{description}
% So a quiz graded entirely on Gradescope needs no option, and an exam whose
% multiple-choice part is on a bubble sheet uses
% \begin{verbatim}
% \usepackage[mc=bubble]{exam-gradescope}
% \end{verbatim}
% Its outline and rubrics then have only the free-response questions. These are
% numbered 1, 2, \dots{} on Gradescope, so each is titled after its printed
% number (``Question 29''). The outline's page numbers are those of the whole
% PDF, which is the template to upload.
%
% \DescribeMacro{\gradescopequestion}
% |\gradescopequestion{|\meta{keys}|}|, anywhere in a question, changes how
% that question is treated:
% \begin{description}
%   \item[\texttt{type=}\meta{mc, cata or frq}] its type;
%   \item[\texttt{destination=}\meta{bubble, gradescope or none}] where it is
%     graded (\texttt{none} leaves it out of everything but the manifest);
%   \item[\texttt{title=}\meta{text}] its title on Gradescope;
%   \item[\texttt{id=}\meta{name}] its name in the manifest;
%   \item[\texttt{points=}\meta{number}] its points, when the document does
%     not give them to \textsf{exam}.
% \end{description}
% In a part, after |\part|, the keys \texttt{title} and \texttt{points} apply
% to the part. A question whose parts have no points of their own has its
% points split evenly among them, with a warning.
%
% \subsection{Names of questions}
%
% The manifest gives each question a name, so that the same question can be
% found on every version even when the questions are shuffled. The name is
% the first |\label| in the question:
% \begin{verbatim}
% \question[2]\label{binomial-sum} ...
% \end{verbatim}
% Labels with an |@| are ignored: \textsf{exam} and
% \textsf{exam-randomizechoices} make those for their own use. A question with
% no label is named by its number.
%
% \subsection{The name and ID regions}
%
% \DescribeMacro{\GradescopeRegion}
% |\GradescopeRegion{|\meta{name or sid}|}{|\meta{material}|}| typesets
% \meta{material} in a box and records where it is, as the region of the
% student's name (\texttt{name}) or ID (\texttt{sid}). Wrap the boxes on the
% cover page in it:
% \begin{verbatim}
% \GradescopeRegion{name}{\fbox{\parbox{3in}{Name:\vspace{2em}}}}\hfill
% \GradescopeRegion{sid}{\fbox{\parbox{2in}{ID:\vspace{2em}}}}
% \end{verbatim}
%
% \subsection{Rubrics}\label{sec:rubrics}
%
% A multiple-choice question gets the rubric
% \begin{quote}
%   \begin{tabular}{rl}
%     \meta{points} & Correct \\
%     0 & The correct response is \textbf{B}
%   \end{tabular}
% \end{quote}
% with positive scoring. A check-all-that-apply question with five choices gets
% negative scoring and the items
% \begin{quote}
%   \begin{tabular}{rl}
%     \meta{points}/5 & A \textbf{should} be selected \\
%     \meta{points}/5 & B \textbf{should not} be selected \\
%     \multicolumn{2}{c}{\dots} \\
%     0 & Correct
%   \end{tabular}
% \end{quote}
% Every rubric has a floor and a ceiling, so a score stays between 0 and the
% question's points.
%
% \DescribeEnv{rubric}
% A free-response question's rubric is written in a \env{rubric} environment
% inside the question (or part):
% \begin{verbatim}
% \begin{question}[6]\label{comb-proof}
%   Give a combinatorial proof that ...
%   \begin{rubric}[scoring=positive]
%     \begin{rubricgroup}[select one]{What is counted}
%       \item[2] Clearly identifies the collection being counted
%       \item[1] Identifies a collection, but vaguely
%       \item[0] No collection identified
%     \end{rubricgroup}
%     \item[0] No response, or no creditable work shown
%   \end{rubric}
% \end{question}
% \end{verbatim}
% Each |\item[|\meta{points}|]| is a rubric item; a \env{rubricgroup} is a
% group of items, which with \texttt{select one} are mutually exclusive. The
% options of \env{rubric} are \texttt{scoring=positive} or
% \texttt{scoring=negative}, \texttt{floor=}\meta{true or false} and
% \texttt{ceiling=}\meta{true or false}; the defaults are positive, true and
% true.
%
% The descriptions are read as written, not typeset: they go to Gradescope,
% whose rubrics use Markdown with \TeX{} math. Math in |\(...\)|, |\[...\]| or
% |$...$| becomes |$$...$$|, |\textbf{...}| becomes |**...**|, and
% |\emph{...}| and |\textit{...}| become |*...*|. Other commands are left
% alone, so keep to ones that MathJax knows inside math.
%
% \DescribeMacro{\DeclareRubric}
% \DescribeMacro{\userubric}
% Many questions share a rubric. |\DeclareRubric[|\meta{options}|]{|^^A
% \meta{name}|}{|\meta{items}|}| declares one, in the preamble, with points as
% fractions of the question's points:
% \begin{verbatim}
% \DeclareRubric{basic}{
%   \item[1]   Correct
%   \item[5/6] Mostly correct, but small mistakes
%   \item[2/3] Major mistakes
%   \item[1/3] Nice try
%   \item[0]   No response, or no creditable work shown}
% \end{verbatim}
% and |\userubric{|\meta{name}|}| in a question uses it, scaled to the
% question's points. An optional argument changes it for that question:
% \begin{verbatim}
% \question[3] ...
% \userubric{basic}[
%   \reword{Correct}{Correct, and explained}
%   \add[before=Major mistakes]{2}{Correct, but not explained}
%   \remove{Nice try}]
% \end{verbatim}
% |\reword{|\meta{old}|}{|\meta{new}|}| rewords the item (or group) whose
% description starts with \meta{old}; |\add[before=|\meta{item}|]| or
% |\add[after=|\meta{item}|]{|\meta{points}|}{|\meta{text}|}| adds an item
% (at the end without an option), worth \meta{points} points, not a fraction;
% |\remove{|\meta{item}|}| removes one.
%
% With the option \texttt{default rubric=}\meta{name}, every free-response
% question (or part) without a rubric of its own gets that one.
%
% \subsection{Options}
%
% Options are given when loading the package or, except for \option{debugregions},
% \DescribeMacro{\gradescopesetup} with |\gradescopesetup{|\meta{keys}|}|.
% \begin{description}
%   \item[\texttt{mc=}\meta{gradescope or bubble}] where multiple-choice and
%     check-all-that-apply questions are graded (default \texttt{gradescope});
%   \item[\texttt{showrubric}] print each rubric under its question when the
%     \textsf{exam} class shows answers (with its \texttt{answers} option), for
%     the graders' copy;
%   \item[\texttt{default rubric=}\meta{name}] the rubric of free-response
%     questions that have none;
%   \item[\texttt{margin=}\meta{length}] how far question regions extend left
%     and right of the text area (default 18pt);
%   \item[\texttt{outline}, \texttt{rubric}, \texttt{key}, \texttt{manifest}]
%     \texttt{=false} to not write that file;
%   \item[\texttt{debugregions}] draw the regions of the previous run on each
%     page, to check them. (Regions are known only once the whole document has
%     been typeset, so this shows the last run's.)
% \end{description}
%
% \section{How regions are found}
%
% A question's region starts where the question starts and runs to where the
% next one starts, across pages if need be, within the text area widened by
% \option{margin}. The last question runs to the foot of its page, where the
% space for its answer is. A part's region runs to the next part, or to the
% end of the question. Slivers shorter than 12pt, left when a question starts
% at the very foot of a page, are dropped.
%
% Each start is recorded with |\latelua|, which gives the exact position on the
% page when the page is shipped out; so the files are right after a single
% run, whatever happens to the page breaks.
%
% \section{The files}
%
% The outline is the body Gradescope's outline editor sends to its server:
% \begin{verbatim}
% {"identification_regions": {
%    "name": {"page_number": 1, "x1": 11.8, "x2": 48.9, "y1": 18.4, "y2": 25.1},
%    "sid":  {"page_number": 1, "x1": 49.2, "x2": 86.4, "y1": 18.4, "y2": 25.1}},
%  "question_data": [
%    {"title": "", "weight": 2,
%     "crop_rect_list": [{"page_number": 1, "x1": 8.8, "x2": 91.2,
%                         "y1": 37.8, "y2": 49.1}]},
%    {"title": "", "children": [{"title": "(a)", "weight": 3, ...}, ...]}]}
% \end{verbatim}
% Coordinates are percentages of the page from its top left corner.
%
% The rubric file is in the format of the \texttt{gradescope-tampermonkey}
% importer: |{"questions": [{"question": "1", "scoring_type": ..., "floor": ...,|
% |"ceiling": ..., "rubric_items": [...], "rubric_item_groups": [...]}]}|,
% where \texttt{question} is the question's number on Gradescope (|"2.1"| for
% the first part of the second question).
%
% The answer key has a header line |Question,Answers,Points,Type| and a line
% such as |3,B,2.0,Exact| for each bubble-sheet question.
%
% The manifest is |{"items": [...]}| with, for each question, its
% \texttt{number}, \texttt{id}, \texttt{points}, \texttt{type} (\texttt{mc},
% \texttt{cata} or \texttt{frq}), \texttt{destination}, \texttt{answer} (the
% correct letters, if any) and \texttt{parts} (a list of |{"points": ...}|).
%
% \section{Limitations}
%
% \begin{itemize}
%   \item Subparts are not regions of their own; their points count towards
%     their part.
%   \item The text area is taken from the page layout at the start of the
%     document. Pages with a different layout (\textsf{exam}'s |\extrawidth|,
%     say) get regions that may be a little narrow.
%   \item Rubric descriptions are converted to Markdown by a few simple rules
%     (above); anything else is passed on as written.
%   \item The bubble-sheet answer key is for multiple-choice questions: a
%     check-all-that-apply question there is written with all its correct
%     letters.
% \end{itemize}
%
% \StopEventually{}
%
% \section{Implementation}
%
% \subsection{The package}
%
%    \begin{macrocode}
%<*package>
\ifdefined\directlua\else
  \PackageError{exam-gradescope}{This package needs LuaLaTeX}{Compile with lualatex.}
  \expandafter\endinput
\fi
\ifdefined\questions\else
  \PackageError{exam-gradescope}{This package needs the exam class}{Use \string\documentclass{exam}, or a class built on it.}
  \expandafter\endinput
\fi

\RequirePackage{etoolbox}
\directlua{examgradescope = require("exam-gradescope")}
%</package>
%    \end{macrocode}
%
% \subsubsection{Options}
%
%    \begin{macrocode}
%<*package>
\newif\ifeg@debug
\newif\ifeg@show
\newif\ifeg@outline \eg@outlinetrue
\newif\ifeg@rubric \eg@rubrictrue
\newif\ifeg@key \eg@keytrue
\newif\ifeg@manifest \eg@manifesttrue
\newcommand\eg@option[2]{\directlua{examgradescope.options["#1"] = #2}}
\DeclareKeys[examgradescope]{
  mc.code = \ifstrequal{#1}{bubble}{\eg@option{mc}{"bubble"}}{%
    \ifstrequal{#1}{gradescope}{\eg@option{mc}{"gradescope"}}{%
      \PackageError{exam-gradescope}{mc should be bubble or gradescope, not '#1'}{}}},
  debugregions.if = eg@debug,
  debugregions.usage = load,
  showrubric.if = eg@show,
  margin.code = \eg@option{margin}{\number\dimexpr#1\relax},
  default~rubric.code = \eg@option{default_rubric}{"\luaescapestring{#1}"},
  outline.if = eg@outline,
  rubric.if = eg@rubric,
  key.if = eg@key,
  manifest.if = eg@manifest,
}
\ProcessKeyOptions[examgradescope]
\NewDocumentCommand\gradescopesetup{m}{\SetKeys[examgradescope]{#1}}
%</package>
%    \end{macrocode}
%
% \subsubsection{Questions and parts}
%
% A position mark, resolved at shipout. |\latelua| expands its argument then, so the arguments are expanded now.
%
%    \begin{macrocode}
%<*package>
\newcommand\eg@mark[2]{%
  \expanded{\noexpand\latelua{examgradescope.mark("#1", #2)}}}

\newcount\eg@index
\newcount\eg@part
%</package>
%    \end{macrocode}
%
% exam defines |\process@question| and |\process@part| inside the questions and parts environments, so they are patched as those begin.
%
%    \begin{macrocode}
%<*package>
\apptocmd\questions{%
  \pretocmd\process@question{%
    \ifhmode\par\fi
    \global\eg@index=\directlua{tex.sprint(examgradescope.start_question(\the\numexpr\value{question}+1\relax))}\relax
    \eg@mark{question}{\the\eg@index}%
  }{}{\PackageError{exam-gradescope}{Could not patch exam's \string\process@question}{}}%
}{}{\PackageError{exam-gradescope}{Could not patch the questions environment}{}}
\AddToHook{env/questions/end}{\ifhmode\par\fi\eg@mark{end}{0}}

\apptocmd\parts{%
  \pretocmd\process@part{%
    \ifhmode\par\fi
    \global\eg@part=\directlua{tex.sprint(examgradescope.start_part(\the\numexpr\value{partno}+1\relax))}\relax
    \eg@mark{part}{\the\eg@index, \the\eg@part}%
  }{}{\PackageError{exam-gradescope}{Could not patch exam's \string\process@part}{}}%
}{}{\PackageError{exam-gradescope}{Could not patch the parts environment}{}}
%</package>
%    \end{macrocode}
%
% |\@readpoints|[pts] runs for questions, parts and subparts. Points may be macros, or use exam's |\half|.
%
%    \begin{macrocode}
%<*package>
\pretocmd\@readpoints{%
  \begingroup
    \def\half{.5}%
    \protected@edef\eg@points{#1}%
    \directlua{examgradescope.points("\luaescapestring{\@queslevel}",
      "\luaescapestring{\expandafter\detokenize\expandafter{\eg@points}}")}%
  \endgroup
}{}{\PackageError{exam-gradescope}{Could not patch exam's \string\@readpoints}{}}
%</package>
%    \end{macrocode}
%
% The first |\label| in a question names it.
%
%    \begin{macrocode}
%<*package>
\AddToHookWithArguments{label}{%
  \protected@edef\eg@label{#1}%
  \directlua{examgradescope.label("\luaescapestring{\expandafter\detokenize\expandafter{\eg@label}}")}}
%</package>
%    \end{macrocode}
%
% Choices: after each environment defines |\choice| and |\CorrectChoice|, wrap them to count the choices (checkboxes have no counter) and note the correct ones.
%
%    \begin{macrocode}
%<*package>
\newcommand\eg@wrapchoices[1]{%
  \directlua{examgradescope.choices("#1")}%
  \let\eg@choice\choice
  \let\eg@CorrectChoice\CorrectChoice
  \def\choice{\directlua{examgradescope.choice(false)}\eg@choice}%
  \def\CorrectChoice{\directlua{examgradescope.choice(true)}\eg@CorrectChoice}%
  \let\correctchoice\CorrectChoice
}
%</package>
%    \end{macrocode}
%
% exam's own environments are patched. With its overload option, exam-randomizechoices replaces them by environments (taking an optional argument) that call the originals, saved as |\erc@old<name>|; if it was loaded first, those originals are the ones to patch.
%
%    \begin{macrocode}
%<*package>
\newcommand\eg@patchchoices[2]{%
  \ifcsdef{erc@old#1}%
    {\expandafter\apptocmd\csname erc@old#1\endcsname{\eg@wrapchoices{#2}}{}{\eg@patchfailed{#1}}}%
    {\expandafter\apptocmd\csname #1\endcsname{\eg@wrapchoices{#2}}{}{\eg@patchfailed{#1}}}}
\newcommand\eg@patchfailed[1]{%
  \PackageError{exam-gradescope}{Could not patch the #1 environment}{}}
\eg@patchchoices{choices}{mc}
\eg@patchchoices{oneparchoices}{mc}
\eg@patchchoices{checkboxes}{cata}
\eg@patchchoices{oneparcheckboxes}{cata}

\NewDocumentCommand\gradescopequestion{m}{%
  \directlua{examgradescope.question_options("\luaescapestring{\detokenize{#1}}")}}
%</package>
%    \end{macrocode}
%
% \subsubsection{Name and ID regions}
%
%    \begin{macrocode}
%<*package>
\NewDocumentCommand\GradescopeRegion{m +m}{%
  \leavevmode
  \setbox\z@=\hbox{#2}%
  \expanded{\noexpand\latelua{examgradescope.region("#1", \number\wd\z@, \number\ht\z@, \number\dp\z@)}}%
  \box\z@
}
%</package>
%    \end{macrocode}
%
% \subsubsection{Rubrics}
%
% A rubric's source is read as text: descriptions go to Gradescope as written, with math as |$$...$$| and |\textbf| as |**...**|.
%
%    \begin{macrocode}
%<*package>
\NewDocumentEnvironment{rubric}{O{} +b}{%
  \directlua{examgradescope.rubric("\luaescapestring{\detokenize{#1}}", "\luaescapestring{\detokenize{#2}}")}%
  \eg@showrubric
}{}

